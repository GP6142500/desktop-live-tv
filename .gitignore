# ===== 依赖 =====
node_modules/
.pnpm-store/
.yarn/

# ===== Next.js 构建产物 =====
# 开发态缓存
.next/
# 静态导出目录（output: 'export' 产物，Tauri frontendDist 指向这里，构建时重新生成）
out/
next-env.d.ts.bak

# ===== Tauri / Rust 构建产物 =====
# Rust 编译输出（体积巨大，必须忽略）
/src-tauri/target/
# Tauri 自动生成的 schema / typescript 绑定（tauri build/dev 时自动重新生成）
/src-tauri/gen/

# ===== 环境变量 / 密钥（切勿提交）=====
.env
.env.*
!.env.example

# ===== 构建 / 类型检查缓存 =====
*.tsbuildinfo
dist/
dist-ssr/

# ===== 编辑器 / IDE =====
.vscode/
.idea/
.settings/
*.swp
*.swo

# ===== 操作系统 =====
.DS_Store
Thumbs.db
ehthumbs.db

# ===== 日志 =====
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ===== 其他 =====
# Windows 调试符号
*.pdb
